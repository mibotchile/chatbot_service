# Cobranza agent — env vars (prefix COBRANZA_). Copy to .env and fill in.
# DO NOT commit .env.

# --- LLM ---
COBRANZA_ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
COBRANZA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Per-tenant keys: {"tenantId": "sk-ant-..."}
COBRANZA_ANTHROPIC_TENANT_KEYS={}

# --- Datastores ---
COBRANZA_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cobranza
COBRANZA_DATABASE_SCHEMA=dev
COBRANZA_REDIS_URL=redis://localhost:6379/6

# --- Security ---
COBRANZA_CSRF_SECRET=CHANGE_ME_IN_PROD
COBRANZA_DASHBOARD_KEY=

# --- Email (internal SendGrid proxy) ---
COBRANZA_MAIL_API_URL=
COBRANZA_NOTIFICATION_EMAIL=

# --- WhatsApp (Evolution API) ---
COBRANZA_WHATSAPP_API_URL=
COBRANZA_WHATSAPP_API_KEY=
COBRANZA_WHATSAPP_INSTANCE=
COBRANZA_WHATSAPP_WEBHOOK_URL=http://agent:8000/api/v1/webhooks/whatsapp
# {"instance-name": {"tenant_id": "demo", "mode": "all"}}
COBRANZA_WHATSAPP_TENANTS={}

# --- Limits ---
COBRANZA_DAILY_MESSAGE_LIMIT=50
