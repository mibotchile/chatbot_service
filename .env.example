# PrestaUnion cobranza demo — environment (COBRANZA_ prefix). Copy to .env.
# NEVER commit the real .env. Values below are PLACEHOLDERS.

# ── LLM provider ──────────────────────────────────────────────────────────
# anthropic (default, native prompt caching) | openai
COBRANZA_LLM_PROVIDER=anthropic
# Active provider's key. Export only the one you use.
COBRANZA_ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
# COBRANZA_OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
# Optional model overrides:
# COBRANZA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# COBRANZA_OPENAI_MODEL=gpt-4o

# ── Reverse proxy (Traefik strip-prefix) ──────────────────────────────────
# Empty in local dev. Behind the proxy set the slug prefix so FastAPI builds
# correct URLs and /docs works. Must match the Traefik PathPrefix/strip middleware.
# automation/demos.mibot.cl example:
# COBRANZA_ROOT_PATH=/pubot-gj5w2a0p
COBRANZA_ROOT_PATH=

# ── Security ───────────────────────────────────────────────────────────────
# CSRF/session HMAC secret. In PRODUCTION use a real random value
# (e.g. `openssl rand -hex 32`). Do NOT ship "demo" or the default.
COBRANZA_CSRF_SECRET=CHANGE_ME_RANDOM_HEX_32_BYTES

# ── Email delivery (internal SendGrid wrapper) ─────────────────────────────
# Reachable from automation. If unset → emails are dry-run logged only.
COBRANZA_MAIL_API_URL=https://apiintranet.mibot.cl:8085/api/v2/mail_sengrid/send

# ── WhatsApp (Evolution API) — BACKLOG, optional ───────────────────────────
# Leave unset for the demo → WhatsApp delivery is an honest dry-run.
# COBRANZA_WHATSAPP_API_URL=http://mila_evolution:8080
# COBRANZA_WHATSAPP_API_KEY=YOUR_EVOLUTION_KEY
# COBRANZA_WHATSAPP_INSTANCE=your-instance
