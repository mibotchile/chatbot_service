FROM python:3.12-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# curl for the container HEALTHCHECK (busybox wget is not in slim).
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Dependency resolution (build context = repo root)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Application source + frontend (served same-origin) + tenant fixtures.
COPY apps/agent/ apps/agent/
COPY frontend/ frontend/
COPY tenants/ tenants/

# Engine modules use absolute imports (from core.X). uv project root is /app.
ENV PYTHONPATH=/app/apps/agent
# Reverse-proxy prefix; empty by default, overridden by .env in prod.
ENV COBRANZA_ROOT_PATH=""

# Run as non-root user.
# /app/data/comprobantes is a mount point for a named volume (uploaded vouchers +
# dedup/audit JSON). Creating + chowning it in the image makes a FRESH named
# volume inherit appuser ownership on first init, so the non-root process can
# mkdir/write under it. Without this the volume initializes root-owned → EACCES.
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --home /home/appuser --ingroup appgroup appuser && \
    mkdir -p /home/appuser/.cache/uv /app/data/comprobantes && \
    chown -R appuser:appgroup /app /home/appuser
USER appuser
ENV HOME=/home/appuser

EXPOSE 8000

# HEALTHCHECK uses 127.0.0.1 (NOT localhost — some minimal images don't resolve it).
# Hits /docs WITHOUT the root_path prefix: FastAPI serves routes internally at root;
# the slug prefix is stripped by Traefik, so the container never sees it directly.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:8000/docs" || exit 1

# uvicorn --root-path mirrors COBRANZA_ROOT_PATH so generated URLs respect the
# Traefik strip-prefix. FastAPI(root_path=...) also reads the env (belt+suspenders).
CMD ["sh", "-c", "uv run --project /app uvicorn api.main:app --app-dir /app/apps/agent --host 0.0.0.0 --port 8000 --root-path \"${COBRANZA_ROOT_PATH}\""]
